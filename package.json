    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-vertical-timeline-component": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
